{
  "name": "dsh-sidepanel-web",
  "version": "0.4.4",
  "type": "module",
  "description": "A DSH Web plugin that adds a Browser tab to the right sidebar: open any page beside the chat, pick an element, and send the agent its selector, HTML, computed styles and a pinned screenshot, so it can find the component and fix the UI. Local/dev pages stay interactive through a same-origin proxy; public pages render in a host Chromium.",
  "icon": "assets/icon.png",
  "author": "Aleix Rocal",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./url": "./lib/url.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "screenshots.json",
    "CHANGELOG.md",
    "README.md",
    "README.ca.md",
    "README.zh.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "scripts": {
    "smoke": "node test/host-smoke.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/page.js && node --check lib/proxy.js && node --check lib/service.js && node --check lib/cdp.js && node --check lib/launcher.js && node --check lib/url.js",
    "test": "node test/url-smoke.mjs && node test/proxy-smoke.mjs",
    "test:url": "node test/url-smoke.mjs",
    "test:proxy": "node test/proxy-smoke.mjs",
    "test:ui": "node test/preview/behavior.mjs",
    "mockups": "node test/preview/mockups.mjs",
    "test:composite": "node test/composite-smoke.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AleixRocal/dsh-sidepanel-web.git"
  },
  "homepage": "https://github.com/AleixRocal/dsh-sidepanel-web#readme",
  "bugs": {
    "url": "https://github.com/AleixRocal/dsh-sidepanel-web/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "browser",
    "dom",
    "sidebar",
    "annotation",
    "element-picker",
    "ui-feedback",
    "screenshot",
    "frontend",
    "web-inspector",
    "cdp",
    "device-emulation",
    "screencast"
  ]
}
